# Used for metadata, sitemap and OpenGraph URLs (see app/layout.tsx,
# app/robots.ts, app/sitemap.ts). Not a secret — this is the site's own
# public domain — so unlike .env/.env*.local this file is meant to be
# committed, baked into the static export at build time.
